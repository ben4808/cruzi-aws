{
  "name": "cruzi-aws",
  "version": "1.0.0",
  "description": "",
  "main": "index.ts",
  "scripts": {
    "start": "ts-node src\\index.ts",
    "debug": "SET SLS_DEBUG=* && node --inspect node_modules\\serverless\\bin\\serverless offline",
    "build": "tsc && npm run copy-prompts",
    "copy-prompts": "node -e \"const fs = require('fs'); const path = require('path'); if (!fs.existsSync('dist/ai')) fs.mkdirSync('dist/ai', { recursive: true }); fs.readdirSync('src/ai').filter(f => f.endsWith('.txt')).forEach(f => fs.copyFileSync(path.join('src/ai', f), path.join('dist/ai', f)));\"",
    "test": "echo \"Error: no test specified\" && exit 1",
    "deploy": "serverless deploy"
  },
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@cursor/sdk": "^1.0.23",
    "@google/genai": "^2.8.0",
    "axios": "^1.10.0",
    "cruzi-db": "file:../cruzi-db",
    "cruzi-models": "file:../cruzi-models",
    "dotenv": "^17.2.3",
    "puppeteer": "^25.1.0",
    "react-icons": "^5.5.0",
    "react-markdown": "^10.1.0"
  },
  "devDependencies": {
    "@types/aws-lambda": "^8.10.149",
    "@types/node": "^22.15.30",
    "serverless": "^4.17.0",
    "serverless-offline": "^14.4.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.8.3"
  }
}
